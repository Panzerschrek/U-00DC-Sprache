import "/random_access_range.iu"

fn GetUnitTestsTable() : ust::array_view_imut</UnitTestsTableElement/>
{
	unsafe
	{
		auto table_ptr= $<( import var</ UnitTestsTableElement />( "__U_unit_tests_table" ) );

		// Unit-tests table is null-terminated. Find this null to determine table size.
		var size_type mut size= 0s;
		while( !ust::is_nullptr( $>( table_ptr + size ).function_pointer ) )
		{
			++size;
		}

		return ust::array_view_imut</UnitTestsTableElement/>( table_ptr, size );
	}
}

// This struct should match the struct used by the compiler for unit-tests table elements.
struct UnitTestsTableElement ordered
{
	( fn() ) function_pointer;
	$(char8) name_begin;
	size_type name_size;
}

// Should have size of exactly 3 pointers.
static_assert( typeinfo</ UnitTestsTableElement />.size_of == typeinfo</ $(byte8) />.size_of * 3s, "Invalid size!" );
