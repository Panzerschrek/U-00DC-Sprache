import "/build_system.iu"

fn GetPackageInfo( BK::BuildSystemInterface &mut build_system_interface ) : BK::PackageInfo
{
	ust::ignore_unused( build_system_interface );

	var BK::BuildTarget mut target
	{
		.target_type = BK::BuildTargetType::SharedLibrary,
		.name= "shared_lib",
		.source_files= ust::make_array</ ust::filesystem_path />( "src/shared_lib.u" ),
		.public_include_directories= ust::make_array</ ust::filesystem_path />( "imports" ),
	};

	return BK::PackageInfo{ .build_targets= ust::make_array( move(target) ) };
}
