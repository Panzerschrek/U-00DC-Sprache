import "/stringifier.iu"
import "/stringifier_apply.iu"
import "serialization.iu"

namespace BK
{

fn SerializeJsonValuePretty( JsonValue& value ) : ust::string8
{
	var ust::default_stringifier8 mut stringifier;
	SerializeJsonValuePrettyImpl( stringifier, 0u, value );
	return move(stringifier).get();
}

fn SerializeJsonValuePrettyImpl( ust::default_stringifier8 &mut stringifier, u32 indentation, JsonValue& value )
{
	if_var( &null_value : value.AsNull() )
	{
		SerializeJsonValuePrettyImpl( stringifier, indentation, null_value );
	}
	else if_var( &bool_value : value.AsBool() )
	{
		SerializeJsonValuePrettyImpl( stringifier, indentation, bool_value );
	}
	else if_var( &number_value : value.AsNumber() )
	{
		SerializeJsonValuePrettyImpl( stringifier, indentation, number_value );
	}
	else if_var( &string_value : value.AsString() )
	{
		SerializeJsonValuePrettyImpl( stringifier, indentation, string_value );
	}
	else if_var( &array_value : value.AsArray() )
	{
		SerializeJsonValuePrettyImpl( stringifier, indentation, array_value );
	}
	else if_var( &object_value : value.AsObject() )
	{
		SerializeJsonValuePrettyImpl( stringifier, indentation, object_value );
	}
}

fn SerializeJsonValuePrettyImpl( ust::default_stringifier8 &mut stringifier, u32 indentation, JsonValue::Null null_value )
{
	ust::ignore_unused( indentation );
	SerializeJsonNull( stringifier, null_value );
}

fn SerializeJsonValuePrettyImpl( ust::default_stringifier8 &mut stringifier, u32 indentation, JsonValue::Bool bool_value )
{
	ust::ignore_unused( indentation );
	SerializeJsonBool( stringifier, bool_value );
}

fn SerializeJsonValuePrettyImpl( ust::default_stringifier8 &mut stringifier, u32 indentation, JsonValue::Number number_value )
{
	ust::ignore_unused( indentation );
	SerializeJsonNumber( stringifier, number_value );
}

fn SerializeJsonValuePrettyImpl( ust::default_stringifier8 &mut stringifier, u32 indentation, JsonValue::String& string_value )
{
	ust::ignore_unused( indentation );
	SerializeJsonString( stringifier, string_value );
}

fn SerializeJsonValuePrettyImpl( ust::default_stringifier8 &mut stringifier, u32 indentation, JsonValue::Array& array_value )
{
	if( array_value.empty() )
	{
		ust::apply_value_to_stringifier( stringifier, "[]" );
	}
	else
	{
		ust::apply_value_to_stringifier( stringifier, "[\n" );

		var size_type mut index= 0s;
		foreach( &sub_value : array_value )
		{
			for( auto mut i= 0s; i < size_type( indentation + 1u ); ++i )
			{
				ust::apply_value_to_stringifier( stringifier, '\t' );
			}

			SerializeJsonValuePrettyImpl( stringifier, indentation + 1u, sub_value );

			++index;
			if( index < array_value.size() )
			{
				ust::apply_value_to_stringifier( stringifier, ',' );
			}
			ust::apply_value_to_stringifier( stringifier, '\n' );
		}

		for( auto mut i= 0s; i < size_type(indentation); ++i )
		{
			ust::apply_value_to_stringifier( stringifier, '\t' );
		}

		ust::apply_value_to_stringifier( stringifier, ']' );
	}
}

fn SerializeJsonValuePrettyImpl( ust::default_stringifier8 &mut stringifier, u32 indentation, JsonValue::Object& object_value )
{
	if( object_value.empty() )
	{
		ust::apply_value_to_stringifier( stringifier, "{}" );
	}
	else
	{
		ust::apply_value_to_stringifier( stringifier, "{\n" );

		var size_type mut index= 0s;
		foreach( &pair : object_value )
		{
			for( auto mut i= 0s; i < size_type( indentation + 1u ); ++i )
			{
				ust::apply_value_to_stringifier( stringifier, '\t' );
			}

			SerializeJsonString( stringifier, pair.key() );

			ust::apply_value_to_stringifier( stringifier, " : " );
			SerializeJsonValuePrettyImpl( stringifier, indentation + 1u, pair.value() );

			++index;
			if( index < object_value.size() )
			{
				ust::apply_value_to_stringifier( stringifier, ',' );
			}
			ust::apply_value_to_stringifier( stringifier, '\n' );
		}

		for( auto mut i= 0s; i < size_type(indentation); ++i )
		{
			ust::apply_value_to_stringifier( stringifier, '\t' );
		}

		ust::apply_value_to_stringifier( stringifier, '}' );
	}
}

fn SerializeJsonNull( ust::default_stringifier8 &mut stringifier, JsonValue::Null null_value )
{
	ust::ignore_unused( null_value );
	ust::apply_value_to_stringifier( stringifier, "null" );
}

fn SerializeJsonBool( ust::default_stringifier8 &mut stringifier, JsonValue::Bool bool_value )
{
	ust::apply_value_to_stringifier( stringifier, bool_value );
}

fn SerializeJsonNumber( ust::default_stringifier8 &mut stringifier, JsonValue::Number number_value )
{
	ust::apply_value_to_stringifier( stringifier, number_value );
}

fn SerializeJsonString( ust::default_stringifier8 &mut stringifier, JsonValue::String& string_value )
{
	ust::apply_value_to_stringifier( stringifier, '"' );

	foreach( c : string_value )
	{
		switch(c)
		{
			'"' -> { ust::apply_value_to_stringifier( stringifier, "\\\"" ) ; },
			'\\' -> { ust::apply_value_to_stringifier( stringifier,  "\\\\" ) ; },
			'\b' -> { ust::apply_value_to_stringifier( stringifier,  "\\b" ) ; },
			'\f' -> { ust::apply_value_to_stringifier( stringifier,  "\\f" ) ; },
			'\n' -> { ust::apply_value_to_stringifier( stringifier,  "\\n" ) ; },
			'\r' -> { ust::apply_value_to_stringifier( stringifier,  "\\r" ) ; },
			'\t' -> { ust::apply_value_to_stringifier( stringifier,  "\\t" ) ; },
			default -> { ust::apply_value_to_stringifier( stringifier, c ); }
		}
	}

	ust::apply_value_to_stringifier( stringifier, '"' );
}

} // namespace BK
