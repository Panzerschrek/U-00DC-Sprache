import "/file_helpers.iu"
import "vfs.iu"

namespace U1
{

fn VfsOverSystemFS::NormalizeFilePath(
	mut this,
	ust::string_view8 file_path,
	ust::string_view8 parent_file_path_normalized ) : ust::string8
{
	// TODO
	ust::ignore_unused( parent_file_path_normalized );
	return file_path;
}

fn VfsOverSystemFS::LoadFile( mut this, ust::string_view8 full_file_path ) : ust::optional</ust::string8/>
{
	result_match( ust::read_file_to_string( full_file_path ) )
	{
		Ok( mut file_contents ) -> { return move( file_contents) ; },
		Err( e ) -> { ust::ignore_unused(e); return ust::null_optional; }
	}
}

fn VfsOverSystemFS::IsImportingFileAllowed( this, ust::string_view8 full_file_path ) : bool
{
	// TODO
	ust::ignore_unused( full_file_path );
	return true;
}

fn VfsOverSystemFS::IsFileFromSourcesDirectory( this, ust::string_view8 full_file_path ) : bool
{
	// TODO
	ust::ignore_unused( full_file_path );
	return true;
}

} // namespace U1
