import "/file_helpers.iu"
import "/filesystem.iu"
import "/path_utils.iu"
import "/stdout_ext.iu"
import "vfs_over_system_fs.iu"

namespace U1
{

fn VfsOverSystemFS::Create(
	ust::array_view_imut</ ust::string8 /> include_dirs,
	ust::vector</ ust::string8 /> mut source_dirs,
	bool prevent_imports_outside_given_directories ) : ust::optional</VfsOverSystemFS/>
{
	auto& separator= "::";

	var ust::vector</PrefixedIncludeDir/> mut prefixed_include_dirs;

	var bool mut all_ok= true;

	foreach( &include_dir : include_dirs )
	{
		var PrefixedIncludeDir mut prefixed_include_dir;

		var bool mut is_prefixed= false;

		for( auto mut i= 0s; i < include_dir.size(); ++i )
		{
			if( include_dir.range().subrange_start(i).starts_with( separator ) )
			{
				// Prefixed include dir.
				is_prefixed= true;

				// Make sure we have no other separator(s).
				for( auto mut j= i + ust::array_size( separator ); j < include_dir.size(); ++j )
				{
					if( include_dir.range().subrange_start(j).starts_with( separator ) )
					{
						ust::stderr_print_line( "Duplicated separator \"", separator, "\" in include string \"", include_dir, "\"!" );
						all_ok= false;
						break;
					}
				}

				prefixed_include_dir.host_fs_path= include_dir.range().subrange_end(i);
				prefixed_include_dir.vfs_path= include_dir.range().subrange_start( i + ust::array_size( separator ) );

				TrimTrailingSlashes( prefixed_include_dir.vfs_path );
				TrimLeadingSlashes( prefixed_include_dir.vfs_path );

				break;
			}
		}

		if( !is_prefixed )
		{
			// No prefix - mount to VFS root.
			prefixed_include_dir.host_fs_path= include_dir;
			prefixed_include_dir.vfs_path= "";
		}

		// Make path absolute.
		if( !ust::path::is_absolute( prefixed_include_dir.host_fs_path ) )
		{
			prefixed_include_dir.host_fs_path= ust::path::join( ust::get_current_directory(), prefixed_include_dir.host_fs_path );
		}

		prefixed_include_dir.host_fs_path= ust::path::normalize( prefixed_include_dir.host_fs_path );

		// Check if given path is an existing directory.
		result_match( ust::get_metadata_for_path( prefixed_include_dir.host_fs_path ) )
		{
			Ok( metadata ) ->
			{
				if( metadata.kind != ust::file_kind::directory )
				{
					ust::stderr_print_line( "\"", prefixed_include_dir.host_fs_path, "\" is not a directory!" );
					all_ok= false;
				}
			},
			Err( e ) ->
			{
				ust::stderr_print_line( "Can't access path \"", prefixed_include_dir.host_fs_path, "\", error: ", e, "!" );
				all_ok= false;
			},
		}

		prefixed_include_dirs.push_back( move( prefixed_include_dir ) );
	}

	foreach( &mut source_dir : source_dirs )
	{
		TrimTrailingSlashes( source_dir );

		if( !ust::path::is_absolute( source_dir ) )
		{
			source_dir= ust::path::join( ust::get_current_directory(), source_dir );
		}
		source_dir= ust::path::normalize( source_dir );
	}

	if( !all_ok )
	{
		return ust::null_optional;
	}

	return
		VfsOverSystemFS(
			move( prefixed_include_dirs ), move( source_dirs ), prevent_imports_outside_given_directories );
}

fn VfsOverSystemFS::constructor(
	ust::vector</ PrefixedIncludeDir /> mut prefixed_include_dirs,
	ust::vector</ ust::filesystem_path /> mut source_dirs,
	bool prevent_imports_outside_given_directories )
	(
		prefixed_include_dirs_= move(prefixed_include_dirs),
		source_dirs_= move(source_dirs),
		prevent_imports_outside_given_directories_= prevent_imports_outside_given_directories,
	)
{}

fn VfsOverSystemFS::NormalizeFilePath(
	mut this,
	ust::string_view8 file_path,
	ust::string_view8 parent_file_path_normalized ) : ust::string8
{
	if( parent_file_path_normalized.empty() )
	{
		// It's a root file. Return normalized path to it and make sure it's absolute.
		if( ust::path::is_absolute( file_path ) )
		{
			return ust::path::normalize( file_path );
		}
		else
		{
			return ust::path::normalize( ust::path::join( ust::get_current_directory(), file_path ) );
		}
	}
	else if( file_path.starts_with( "/" ) )
	{
		// If given path is absolute (like "/some_lib/some_file.u"), search for a file in include dirs.
		// Return real file system path for first existing file.
		foreach( & prefixed_include_dir : prefixed_include_dirs_ )
		{
			auto mut given_path_it= ust::path::components_iter( file_path.subrange_start( 1s ) /* skip first "/" */ );

			auto mut prefix_it= ust::path::components_iter( prefixed_include_dir.vfs_path );

			loop
			{
				auto prefix_component_opt= prefix_it.next();
				if( prefix_component_opt.empty() )
				{
					break;
				}

				auto given_path_component_opt= given_path_it.next();
				if( given_path_component_opt.empty() )
				{
					break;
				}

				if( given_path_component_opt.try_deref() != prefix_component_opt.try_deref() )
				{
					break;
				}
			}

			if( prefix_it.next().empty() )
			{
				// Given path is a subdirectory inside "vfs_path".

				// Since "host_fs_path" is absolute, the result will be absolute too.

				var ust::filesystem_path mut full_file_path= prefixed_include_dir.host_fs_path;
				foreach( &component : move(given_path_it) )
				{
					ust::path::append( full_file_path, component );
				}

				// Make sure this file exists. If no - try other include directories.

				result_match( ust::get_metadata_for_path( full_file_path ) )
				{
					Ok( metadata ) ->
					{
						if( metadata.kind == ust::file_kind::file )
						{
							return ust::path::normalize( full_file_path );
						}
					},
					Err( e ) -> { ust::ignore_unused(e); },
				}
			}
			else
			{
				move(given_path_it);
			}
		}

		return ""; // Found nothing.
	}
	else
	{
		// Relative import.
		if_var( parent_directory : ust::path::get_parent_path( parent_file_path_normalized ) )
		{
			return ust::path::normalize( ust::path::join( parent_directory, file_path ) );
		}
		else
		{
			return "";
		}
	}
}

fn VfsOverSystemFS::LoadFile( mut this, ust::string_view8 full_file_path ) : ust::io_result</ust::string8/>
{
	return ust::read_file_to_string( full_file_path );
}

fn VfsOverSystemFS::IsImportingFileAllowed( this, ust::string_view8 full_file_path ) : bool
{
	if( !prevent_imports_outside_given_directories_ )
	{
		return true;
	}

	foreach( &prefixed_include_dir : prefixed_include_dirs_ )
	{
		if( IsWithinGivenDirectory( full_file_path, prefixed_include_dir.host_fs_path ) )
		{
			return true;
		}
	}

	foreach( &source_dir : source_dirs_ )
	{
		if( IsWithinGivenDirectory( full_file_path, source_dir ) )
		{
			return true;
		}
	}

	// Import outside allowed directories.
	return false;
}

fn VfsOverSystemFS::IsFileFromSourcesDirectory( this, ust::string_view8 full_file_path ) : bool
{
	foreach( &source_dir : source_dirs_ )
	{
		if( IsWithinGivenDirectory( full_file_path, source_dir ) )
		{
			return true;
		}
	}

	return false;
}

// Given paths should be absolute and normalized!
fn IsWithinGivenDirectory( ust::filesystem_path_view full_file_path, ust::filesystem_path_view directory_path ) : bool
{
	auto mut given_path_it= ust::path::components_iter( full_file_path );
	auto mut directory_path_it= ust::path::components_iter( directory_path );

	loop
	{
		auto directory_path_component_opt= directory_path_it.next();
		if( directory_path_component_opt.empty() )
		{
			return true;
		}

		auto given_path_component_opt= given_path_it.next();
		if( given_path_component_opt.empty() )
		{
			return false;
		}

		if( given_path_component_opt.try_deref() != directory_path_component_opt.try_deref() )
		{
			return false;
		}
	}
}

fn TrimTrailingSlashes( ust::string8 &mut s )
{
	while( !s.empty() && IsSlash( s.back() ) )
	{
		s.drop_back();
	}
}

fn TrimLeadingSlashes( ust::string8 &mut s )
{
	var size_type mut num_leading_slashes= 0s;

	while( num_leading_slashes < s.size() && IsSlash( s[ num_leading_slashes ] ) )
	{
		++num_leading_slashes;
	}

	if( num_leading_slashes > 0s )
	{
		var size_type new_size= s.size() - num_leading_slashes;
		for( auto mut i= 0s; i < new_size; ++i )
		{
			var char8 c= s[ i + num_leading_slashes ];
			s[i]= c;
		}
		s.resize( new_size, '\0' );
	}
}

fn IsSlash( char8 c ) : bool
{
	return c == '/' | c == '\\';
}

} // namespace U1
