	halt;
}

fn Enum::stringify( this, ust::default_stringifier8 &mut stringifier )
{
	ust::apply_value_to_stringifier( stringifier, names_scope.lock_imut().deref() );
}

fn TypeTemplate::stringify( this, ust::default_stringifier8 &mut stringifier )
{
	with( &n : parent_names_scope.upgrade().try_lock_imut().deref() )
	{
		if( !n.GetParent().empty() )
		{
			ust::apply_value_to_stringifier( stringifier, n );
			ust::apply_value_to_stringifier( stringifier, "::" );
		}
	}
	ust::apply_value_to_stringifier( stringifier, syntax_element.deref().name );
}

