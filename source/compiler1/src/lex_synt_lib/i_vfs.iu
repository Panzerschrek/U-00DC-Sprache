import "/io_result.iu"
import "/shared_ptr.iu"
import "/string.iu"

namespace U1
{

class IVfs interface
{
	fn virtual pure NormalizeFilePath(
		mut this,
		ust::string_view8 file_path,
		ust::string_view8 parent_file_path_normalized ) : ust::string8;

	// Empty "full_parent_file_path" means root file.
	fn virtual pure LoadFile( mut this, ust::string_view8 full_file_path ) : ust::io_result</ust::string8/>;

	// Returns "false" if it isn't allowed to import file given.
	fn virtual pure IsImportingFileAllowed( this, ust::string_view8 full_file_path ) : bool;

	// Returns "true" if file given is located within one of source directories.
	fn virtual pure IsFileFromSourcesDirectory( this, ust::string_view8 full_file_path ) : bool;
}

type IVfsSharedPtr= ust::shared_ptr_mut</IVfs/>;

} // namespace U1
