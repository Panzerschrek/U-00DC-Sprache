import "../imports/string_base.iu"

namespace ust
{

template</type C/>
fn to_string_impl( string_base</C/> &mut s, ssize_type x )
{
	static_if( typeinfo</ssize_type/>.size_of == typeinfo</i32/>.size_of )
	{
		to_string_impl( s, i32(x) );
	}
	else
	{
		to_string_impl( s, i64(x) );
	}
}

template</type C/>
fn to_string_impl( string_base</C/> &mut s, size_type x )
{
	static_if( typeinfo</ssize_type/>.size_of == typeinfo</u32/>.size_of )
	{
		to_string_impl( s, u32(x) );
	}
	else
	{
		to_string_impl( s, u64(x) );
	}
}

template</type C/>
fn to_string_impl( string_base</C/> &mut s, i8 x )
{
	if( i32(x) >= 0 )
	{
		to_string_impl</C/>( s, u8( x) );
	}
	else
	{
		s.push_back( C('-') );
		to_string_impl</C/>( s, u8(-x) );
	}
}

template</type C/>
fn to_string_impl( string_base</C/> &mut s, i16 x )
{
	if( i32(x) >= 0 )
	{
		to_string_impl</C/>( s, u16( x) );
	}
	else
	{
		s.push_back( C('-') );
		to_string_impl</C/>( s, u16(-x) );
	}
}

template</type C/>
fn to_string_impl( string_base</C/> &mut s, i32 x )
{
	if( x >= 0 )
	{
		to_string_impl</C/>( s, u32( x) );
	}
	else
	{
		s.push_back( C('-') );
		to_string_impl</C/>( s, u32(-x) );
	}
