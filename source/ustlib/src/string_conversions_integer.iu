template</type C/>
fn to_string_impl( string_base</C/> &mut s, i64 x )
{
	if( x >= 0i64 )
	{
		to_string_impl</C/>( s, u64( x) );
	}
	else
	{
		s.push_back( C('-') );
		to_string_impl</C/>( s, u64(-x) );
