}

template</type C/>
fn to_string_impl( string_base</C/> &mut s, i128 x )
{
	if( x >= 0i128 )
	{
		to_string_impl</C/>( s, u128( x) );
	}
	else
	{
		s.push_back( C('-') );
		to_string_impl</C/>( s, u128(-x) );
	}
}

// 8-bit version.
template</type C/>
fn to_string_impl( string_base</C/>& mut s , u8 in_x )
{
	auto constexpr zero_char= C('0');

	var u32 x(in_x);

	if( x >= 100u )
	{
		s.push_back( C( u32(zero_char) + x / 100u ) );
		s.push_back( C( u32(zero_char) + x / 10u % 10u ) );
	}
	else if( x >= 10u )
	{
		s.push_back( C( u32(zero_char) + x / 10u ) );
	}

	s.push_back( C( u32(zero_char) + x % 10u ) );
}

// 16-bit version.
template</type C/>
fn to_string_impl( string_base</C/>& mut s, u16 in_x )
{
	auto constexpr zero_char= C('0');

	var u32 x(in_x);

	if( x == 0u )
	{
		s.push_back(zero_char);
	}
	else
	{
		var u32 mut div= 10000u;
		while( div > x )
		{
			div/= 10u;
		}

		var u32 mut rem= x;
		while( div > 0u )
		{
			auto digit= rem / div;
			s.push_back( C( digit + u32(zero_char) ) );
			rem-= digit * div;
			div/= 10u;
		}
	}
}

// 32-bit version.
template</type C/>
fn to_string_impl( string_base</C/>& mut s, u32 x )
{
	auto constexpr zero_char= C('0');

	if( x == 0u )
	{
		s.push_back(zero_char);
	}
	else
	{
		var u32 mut div= 1000000000u;
		while( div > x )
		{
			div/= 10u;
		}

		var u32 mut rem= x;
		while( div > 0u )
		{
			auto digit= rem / div;
			s.push_back( C( digit + u32( zero_char ) ) );
			rem-= digit * div;
			div/= 10u;
		}
	}
}

// 64-bit version.
template</type C/>
fn to_string_impl( string_base</C/>& mut s, u64 x )
{
	auto constexpr zero_char= C('0');

	if( x == 0u64 )
	{
		s.push_back(zero_char);
	}
	else
	{
		var u64 mut div= 10000000000000000000u64;
		while( div > x )
		{
			div/= 10u64;
		}

		var u64 mut rem= x;
		while( div > 0u64 )
		{
			auto digit= rem / div;
			s.push_back( C( u32( digit ) + u32( zero_char ) ) );
			rem-= digit * div;
			div/= 10u64;
		}
	}
}

// 128-bit version.
template</type C/>
fn to_string_impl( string_base</C/>& mut s, u128 x )
{
	// A speculative optimization.
	// Assume that a lot of 128-bit numbers don't have upper 64 bits set.
	// If it's the case, use 64-bit number stringification, since it's significantly faster.
	if( ( x >> 64 ) == 0u128 )
	{
		return to_string_impl( s, u64(x) );
	}

	auto constexpr zero_char= C('0');

	if( x == 0u128 )
	{
		s.push_back(zero_char);
	}
	else
	{
		// This code is painfully-slow,
		// since it requires 128-bit division,
		// which isn't supported in hardware (at least on mainstream systems) and is emulated instead via div built-ins.

		var u128 mut div= 100000000000000000000000000000000000000u128;
		while( div > x )
		{
			div/= 10u128;
		}

		var u128 mut rem= x;
		while( div > 0u128 )
		{
			auto digit= rem / div;
			s.push_back( C( u32( digit ) + u32( zero_char ) ) );
			rem-= digit * div;
			div/= 10u128;
		}
	}
}

template</type C/>
fn to_string_impl( string_base</C/> &mut s, byte8 x )
{
	var u32 num( u8(x) );

	var [ C, 4 ] chars
	[
		( '0' ),
		( 'x' ),
		( g_hex_digits[ ( num >> 4 ) & 15u ] ),
		( g_hex_digits[ ( num >> 0 ) & 15u ] ),
	];

	s+= chars;
}

template</type C/>
fn to_string_impl( string_base</C/> &mut s, byte16 x )
{
	var u32 num( u16(x) );

	var [ C, 6 ] chars
	[
		( '0' ),
		( 'x' ),
		( g_hex_digits[ ( num >> 12 ) & 15u ] ),
		( g_hex_digits[ ( num >>  8 ) & 15u ] ),
		( g_hex_digits[ ( num >>  4 ) & 15u ] ),
		( g_hex_digits[ ( num >>  0 ) & 15u ] ),
	];

	s+= chars;
}

