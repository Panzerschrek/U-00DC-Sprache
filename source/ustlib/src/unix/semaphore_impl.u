import "../../imports/memory.iu"
import "../../imports/alloc.iu"
import "../../imports/atomic.iu"
import "../../imports/semaphore_impl.iu"
import "../../imports/stringification.iu"
import "errno.iu"
import "semaphore.iu"

namespace ust
{

namespace semaphore_impl
{

static_assert( same_type</ semaphore_handle_t, $(byte8) />, "Invalid type for semaphore handle!" );

var bool is_darwin= constexpr_string_equals( compiler::target::vendor, "apple" );

var u32 mut semaphore_unique_index= 1u;

fn create_semaphore( u32 initial_value ) unsafe : semaphore_handle_t
{
	static_if( is_darwin )
	{
		// MacOS doesn't support unnamed semaphores, so, create named one.
		// Use process ID and atomic variable to generate names - to ensure uniqueness.

		var pid_t pid= unsafe( ::getpid() );
		var u32 id= unsafe( atomic_inc( semaphore_unique_index ) );

		var string8 mut name_nt= stringify8( "/u_semaphore_", pid, "_", id, "\0" );

		var $(sem_t) res= unsafe( ::sem_open( name_nt.data(), i32(O_CREAT | O_EXCL), mode_t(0o744), initial_value ) );
		halt if( is_nullptr(res) );
		return unsafe( ptr_cast_to_byte8( res ) );
	}
	else
	{
		ignore_unused( unsafe( semaphore_unique_index ) );

		unsafe
		{
			// We need stable address of the semaphore object, so, allocate it on heap.
			var $(byte8) mem= memory_allocate( typeinfo</sem_t/>.size_of );
			var i32 res= ::sem_init( byte_ptr_cast</sem_t/>( mem ), 0, initial_value );
			halt if( res != 0 );
			return mem;
		}
	}
}

fn destroy_semaphore( semaphore_handle_t s ) unsafe
{
	static_if( is_darwin )
	{
		unsafe( ::sem_close( byte_ptr_cast</sem_t/>(s) ) );
	}
	else
	{
		unsafe
		{
			::sem_destroy( byte_ptr_cast</sem_t/>( s ) );
			memory_free( s );
		}
	}
}

fn acquire_semaphore( semaphore_handle_t s ) unsafe
{
	unsafe
	{
		var i32 res= ::sem_wait( byte_ptr_cast</sem_t/>( s ) );
		halt if( res != 0 );
	}
}

fn nodiscard acquire_semaphore_timeout( semaphore_handle_t s, duration timeout ) unsafe : bool
{
	static_if( is_darwin )
	{
		ignore_unused( timeout );

		// HACK!
		// "sem_timedwait" is missing on MacOS. So, jus use "sem_trywait".
		return unsafe( sem_trywait( byte_ptr_cast</sem_t/>( s ) ) ) == 0;
	}
	else
	{
		// Request current time and add given timeout to it in order to calculate timeout time point.

		var u64 timeout_nanoseconds= timeout.ceil_to_nanoseconds();

		var timespec mut now= zero_init;
		halt if( unsafe( clock_gettime( clockid_t( CLOCK_REALTIME /* This clock is hardcoded for semaphores. */ ), $<(now) ) ) != 0 );

		var u64 constexpr ns= 1000000000u64;

		// TODO - make sure no overflow happens here.
		var u64 wake_up_time_point_fractional_nanoseconds= ( u64( now.tv_nsec ) + timeout_nanoseconds ) % ns;
		var i64 wake_up_time_point_seconds= i64( ( u64( now.tv_nsec ) + timeout_nanoseconds ) / ns ) + i64( now.tv_sec );

		var timespec mut wake_up_time_point
		{
			.tv_sec ( wake_up_time_point_seconds ),
			.tv_nsec( wake_up_time_point_fractional_nanoseconds ),
		};

		var i32 res= unsafe( ::sem_timedwait( byte_ptr_cast</sem_t/>( s ), $<( wake_up_time_point ) ) );
		return res == 0;
	}
}

fn release_semaphore( semaphore_handle_t s ) unsafe
{
	unsafe
	{
		var i32 res= ::sem_post( byte_ptr_cast</sem_t/>( s ) );
		halt if( res != 0 );
	}
}

} // namespace semaphore_impl

} // namespace ust
