import "../imports/string_conversions.iu"
import "string_conversions_floating_point.iu"

namespace ust
{

fn to_string8( f32 x ) : string8
{
	var string8 mut s;
	f32_impl::to_string( s, x );
	return s;
}

fn to_string16( f32 x ) : string16
{
	var string16 mut s;
	f32_impl::to_string( s, x );
	return s;
}

fn to_string32( f32 x ) : string32
{
	var string32 mut s;
	f32_impl::to_string( s, x );
	return s;
}

fn to_string8( f64 x ) : string8
{
	var string8 mut s;
	f64_impl::to_string( s, x );
	return s;
}

fn to_string16( f64 x ) : string16
{
	var string16 mut s;
	f64_impl::to_string( s, x );
	return s;
}

fn to_string32( f64 x ) : string32
{
	var string32 mut s;
	f64_impl::to_string( s, x );
	return s;
}

} // namespace ust
