{
	var ust::string8 mut s;
	to_string_impl( s, x );
	return s;
}

fn to_string8 ( u64 x ) : string8
{
	var ust::string8 mut s;
	to_string_impl( s, x );
	return s;
}

fn to_string8 ( i128 x ) : string8
{
	var ust::string8 mut s;
