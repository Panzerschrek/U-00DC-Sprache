template</type C/>
fn to_string( i8 x ) : string_base</C/>
{
	var string_base</C/> mut s;
	if( i32(x) >= 0 )
	{
		to_string_impl</C/>( s, u8( x) );
	}
	else
	{
		s.push_back( C('-') );
		to_string_impl</C/>( s, u8(-x) );
	}
	return s;
}

template</type C/>
fn to_string( u8 x ) : string_base</C/>
{
	var string_base</C/> mut s;
	to_string_impl</C/>( s, x );
	return s;
}

