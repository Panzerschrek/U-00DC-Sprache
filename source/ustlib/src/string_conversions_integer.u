		( g_hex_digits[ ( num >> 12 ) & 15u ] ),
		( g_hex_digits[ ( num >>  8 ) & 15u ] ),
		( g_hex_digits[ ( num >>  4 ) & 15u ] ),
		( g_hex_digits[ ( num >>  0 ) & 15u ] ),
	];

