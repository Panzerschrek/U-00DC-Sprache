import "../imports/string_conversions.iu"

namespace ust
{

fn to_string8 ( void x ) : string8
{
	ignore_unused(x);
	return "void";
}

fn to_string8 ( bool x ) : string8
{
	if( x ){ return "true"; }
	return "false";
}

fn to_string8 ( i8 x ) : string8
{
	return to_string</char8 />(x);
}

fn to_string8 ( u8 x ) : string8
{
	return to_string</char8 />(x);
}

fn to_string8 ( i16 x ) : string8
{
	return to_string</char8 />(x);
}

fn to_string8 ( u16 x ) : string8
{
	return to_string</char8 />(x);
}

fn to_string8 ( i32 x ) : string8
{
