import "../imports/string_conversions.iu"
import "string_conversions_integer.iu"

namespace ust
{

fn to_string8 ( void x ) : string8
{
	ignore_unused(x);
	return "void";
}

fn to_string8 ( bool x ) : string8
{
	if( x ){ return "true"; }
	return "false";
}

fn to_string8 ( i8 x ) : string8
{
	var ust::string8 mut s;
	to_string_impl( s, x );
	return s;
}

fn to_string8 ( u8 x ) : string8
{
	var ust::string8 mut s;
	to_string_impl( s, x );
	return s;
}

fn to_string8 ( i16 x ) : string8
{
