template</type C/>
fn to_string_impl( string_base</C/> &mut s, byte128 x )
{
	// TODO - consider optimizing this code.
	// Doing bit shifts for 128-bit integers may be costly.

	var u128 num( x );

	var [ C, 34 ] chars
	[
		( '0' ),
		( 'x' ),
		( g_hex_digits[ ( num >> 124 ) & 15u128 ] ),
		( g_hex_digits[ ( num >> 120 ) & 15u128 ] ),
		( g_hex_digits[ ( num >> 116 ) & 15u128 ] ),
		( g_hex_digits[ ( num >> 112 ) & 15u128 ] ),
		( g_hex_digits[ ( num >> 108 ) & 15u128 ] ),
		( g_hex_digits[ ( num >> 104 ) & 15u128 ] ),
		( g_hex_digits[ ( num >> 100 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  96 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  92 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  88 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  84 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  80 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  76 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  72 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  68 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  64 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  60 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  56 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  52 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  48 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  44 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  40 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  36 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  32 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  28 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  24 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  20 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  16 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>  12 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>   8 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>   4 ) & 15u128 ] ),
		( g_hex_digits[ ( num >>   0 ) & 15u128 ] ),
	];

	s+= chars;
}

var [ char8, 16 ] g_hex_digits= "0123456789ABCDEF";

} // namespace ust
