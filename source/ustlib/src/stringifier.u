op default_stringifier16::()( mut this, char8 x )
{
	// Giving only single char we can't do anything but assuming it's just an 7-bit code point.
	// Normally this code should not be executed, whole strings should be processed instead.
	utf::push_code_point_to_string( str_, char32(x) );
}

op default_stringifier16::()( mut this, char32 x )
{
	utf::push_code_point_to_string( str_, x );
}

