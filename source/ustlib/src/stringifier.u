{
	while( !arr.empty() )
	{
		var char32 cp= utf::extract_code_point_or_null_from_string(arr);
		if( cp == char32(0) )
		{
			break;
		}
		// TODO - handle cases when given string contains broken UTF-8 or zero chars?

		utf::push_code_point_to_string( str_, cp );
	}
}

