import "../imports/stringifier.iu"
import "../imports/utf.iu"
import "string_conversions_floating_point.iu"
import "string_conversions_integer.iu"

namespace ust
{

op default_stringifier8::()( mut this, void x )
{
	str_+= "void";
	ignore_unused(x);
}

op default_stringifier8::()( mut this, bool x )
{
	if( x )
	{
		str_+= "true";
	}
	else
	{
		str_+= "false";
	}
}

op default_stringifier8::()( mut this, u8 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, i8 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, u16 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, i16 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, u32 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, i32 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, u64 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, i64 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, u128 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, i128 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, size_type x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, ssize_type x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, f32 x )
{
	f32_impl::to_string( str_, x );
}

op default_stringifier8::()( mut this, f64 x )
{
	f64_impl::to_string( str_, x );
}

op default_stringifier8::()( mut this, char16 x )
{
	// TODO - handle broken/wierd UTF-16 here?
	auto mut view= single_element_array_view( x );
	utf::push_code_point_to_string( str_, utf::extract_code_point_or_null_from_string( view ) );
}

op default_stringifier8::()( mut this, char32 x )
{
	utf::push_code_point_to_string( str_, x );
}

op default_stringifier8::()( mut this, byte8 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, byte16 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, byte32 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, byte64 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, byte128 x )
{
	to_string_impl( str_, x );
}

op default_stringifier8::()( mut this, array_view_imut</char16/> mut arr )
{
	while( !arr.empty() )
	{
		var char32 cp= utf::extract_code_point_or_null_from_string(arr);
		if( cp == char32(0) )
		{
			break;
		}
		// TODO - handle cases when given string contains broken UTF-16 or zero chars?

		utf::push_code_point_to_string( str_, cp );
	}
}

op default_stringifier8::()( mut this, array_view_imut</char32/> arr )
{
	foreach( cp : arr )
	{
		utf::push_code_point_to_string( str_, cp );
	}
}

