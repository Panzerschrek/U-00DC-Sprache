import "stdout.iu"
import "string.iu"
import "stringifier.iu"

namespace ust
{

fn stdout_print_line()
{
	stdout_print( "\n" );
}

template</type A/>
fn stdout_print_line( A& a )
{
	var default_stringifier8 mut stringifier;
	apply_value_to_stringifier( stringifier, a );
	apply_value_to_stringifier( stringifier, '\n' );
	stdout_print( move(stringifier).get() );
}

template</type A, type B/>
fn stdout_print_line( A& a, B& b )
{
	var default_stringifier8 mut stringifier;
	apply_value_to_stringifier( stringifier, a );
	apply_value_to_stringifier( stringifier, b );
	apply_value_to_stringifier( stringifier, '\n' );
	stdout_print( move(stringifier).get() );
}

