	op()( mut this, i64 x );
	op()( mut this, u128 x );
	op()( mut this, i128 x );

	op()( mut this, char8 x );
	op()( mut this, char16 x ) { str_.push_back( x ); }
	op()( mut this, char32 x );

	op()( mut this, byte8 x );
	op()( mut this, byte16 x );
	op()( mut this, byte32 x );
	op()( mut this, byte64 x );
	op()( mut this, byte128 x );

	op()( mut this, array_view_imut</char8/> arr );
	op()( mut this, array_view_imut</char16/> arr ) { str_+= arr; }
	op()( mut this, array_view_imut</char32/> arr );

	// Get result string.
