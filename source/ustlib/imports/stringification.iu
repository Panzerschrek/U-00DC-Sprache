import "string.iu"
import "stringifier.iu"

namespace ust
{

fn stringify8() : string8
{
	return string8();
}

template</type A/>
fn stringify8( A& a ) : string8
{
	var default_stringifier8 mut stringifier;
	apply_value_to_stringifier( stringifier, a );
	return move(stringifier).get();
}

template</type A, type B/>
fn stringify8( A& a, B& b ) : string8
{
	var default_stringifier8 mut stringifier;
	apply_value_to_stringifier( stringifier, a );
	apply_value_to_stringifier( stringifier, b );
	return move(stringifier).get();
}

