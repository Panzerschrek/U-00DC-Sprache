//##success_test
import "../imports/string.iu"
import "../imports/stringifier.iu"
import "../imports/stringifier_apply.iu"

fn nomangle main() call_conv( "C" ) : i32
{
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, -63433 ); // Should handle integers.
		halt if( move( stringifier ).get() != "-63433" );
	}
	{
		var ust::default_stringifier8 mut stringifier;

		ust::apply_value_to_stringifier( stringifier, '!' ); // Should handle chars.
		ust::apply_value_to_stringifier( stringifier, 74.0f ); // Should handle floating-point numbers.
		ust::apply_value_to_stringifier( stringifier, ust::string_view8( " : " ) ); // Should handle string views.
		ust::apply_value_to_stringifier( stringifier, false ); // Should handle bol values.
		ust::apply_value_to_stringifier( stringifier, ", " ); // Should handle char arrays.
		ust::apply_value_to_stringifier( stringifier, byte8( 0x67u8 ) ); // Should handle byte types.
		ust::apply_value_to_stringifier( stringifier, ".\n" );

		halt if( move( stringifier ).get() != "!74 : false, 0x67.\n" );
	}
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, ust::make_array</u32/>() ); // Array with zero elements.
		halt if( move( stringifier ).get() != "[]" );
	}
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, ust::make_array( 43447398u ) ); // Array with single element.
		halt if( move( stringifier ).get() != "[ 43447398 ]" );
	}
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, ust::make_array( 78, -234, 2363 ) ); // Array with many elements.
		halt if( move( stringifier ).get() != "[ 78, -234, 2363 ]" );
	}
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, ust::make_tuple() ); // Tuple with zero elements.
		halt if( move( stringifier ).get() != "[]" );
	}
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, ust::make_tuple( 'T' ) ); // Tuple with single element.
		halt if( move( stringifier ).get() != "[ T ]" );
	}
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, ust::make_tuple( 78u, -2 ) ); // Tuple with two elements.
		halt if( move( stringifier ).get() != "[ 78, -2 ]" );
	}
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, ust::make_tuple( false, 5323, 'R' ) ); // Tuple with three elements.
		halt if( move( stringifier ).get() != "[ false, 5323, R ]" );
	}
	{
		var ust::default_stringifier8 mut stringifier;
		ust::apply_value_to_stringifier( stringifier, ust::make_array( SomeEnum::Herren, SomeEnum::der, SomeEnum::Winde ) ); // Array with enum elements.
		halt if( move( stringifier ).get() != "[ Herren, der, Winde ]" );
	}

	return 0;
}

enum SomeEnum{ Herren, der, Winde }
