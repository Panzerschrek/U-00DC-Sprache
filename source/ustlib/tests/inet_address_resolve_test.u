//##success_test
import "../imports/assert.iu"
import "../imports/inet_address_resolve.iu"
import "../imports/stdout_ext.iu"

fn nomangle main() call_conv( "C" ) : i32
{

	var [ ust::string_view8, 11 ] sites
	[
		"localhost",
		"example.com",
		"github.com",
		"microsoft.com",
		"google.com",
		"idsoftware.com",
		"yandex.ru",
		"wikipedia.org",
		"bundesregierung.de",
		"arte.tv",
		"яндекс.рф"
		];

	foreach( &site : sites )
	{
		var ust::vector</ust::ip_address/> addresses= ust::resolve_inet_address( site );
		ust::stdout_print_line( "Has ", addresses.size(), " addresses for \"", site, "\"" );

		foreach( &a : addresses )
		{
			ust::stdout_print_line( a );
		}
	}

	return 0;
}
