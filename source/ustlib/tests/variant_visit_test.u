//##success_test
import "../imports/variant.iu"

fn nomangle main() call_conv( "C" ) : i32
{
	{
		var ust::variant</ tup[ i32, f32 ] /> v(55);

		var f64 mut r= 0.0;
		variant_visit( el : v )
		{
			r= f64(el);
		}
		halt if( r != 55.0 );
	}
	{
		var ust::variant</ tup[ i32, f32 ] /> v( -72.5f );

		var f64 mut r= 0.0;
		variant_visit( el : v )
		{
			r= f64(el);
		}
		halt if( r != -72.5 );
	}
	{
		var ust::variant</ tup[ char8, f64 ] /> mut v( 7.7 );

		variant_visit( &mut el : v )
		{
			el= typeof(el)(33);
		}
		halt if( v.get</f64/>().try_deref() != 33.0 );
	}
	{
		var ust::variant</ tup[ char8, f64 ] /> mut v( 'S' );

		variant_visit( &mut el : v )
		{
			el= typeof(el)(33);
		}
		halt if( v.get</char8/>().try_deref() != '!' );
	}
	{
		var ust::variant</ tup[ f32, char8, i32 ] /> v0= 0.25f, v1= 'G', v2= 784;

		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_visit2( v0 )
			{
				( f32 f ) -> { halt if( f != 0.25f ); f_visited= true; },
				( char8 c ) -> { c_visited= true; },
				( i32 i ) ->{ i_visited= true; }
			}
			halt if( !f_visited );
			halt if( c_visited );
			halt if( i_visited );
		}
		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_visit2( v1 )
			{
				( f32 f ) -> { f_visited= true; },
				( char8 c ) -> { halt if( c != 'G' ); c_visited= true; },
				( i32 i ) ->{ i_visited= true; }
			}
			halt if( f_visited );
			halt if( !c_visited );
			halt if( i_visited );
		}
		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_visit2( v2 )
			{
				( f32 f ) -> { f_visited= true; },
				( char8 c ) -> { c_visited= true; },
				( i32 i ) ->{ halt if( i != 784 ); i_visited= true; }
			}
			halt if( f_visited );
			halt if( c_visited );
			halt if( !i_visited );
		}
	}

	return 0;
}
