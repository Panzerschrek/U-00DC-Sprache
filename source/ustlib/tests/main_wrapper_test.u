//##success_test
import "../imports/main_wrapper.iu"
import "../imports/stdout.iu"
import "../imports/stringification.iu"

pretty_main
{
	ust::stdout_print( ust::stringify8( "Has total ", args.size(), " command-line args:\n" ) );

	foreach( &arg : args )
	{
		ust::stdout_print( arg );
		ust::stdout_print( "\n" );
	}
	ust::stdout_print( "\n" );

	return 0;
}
