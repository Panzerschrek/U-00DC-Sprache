//##success_test
import "../imports/variant.iu"

fn nomangle main() call_conv( "C" ) : i32
{
	{ // Basic "variant_switch" with values observing.
		var ust::variant</ tup[ f32, char8, i32 ] /> v0= 0.25f, v1= 'G', v2= 784;

		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_switch( v0 )
			{
				( f32 f ) -> { halt if( f != 0.25f ); f_visited= true; },
				( char8 c ) -> { c_visited= true; },
				( i32 i ) ->{ i_visited= true; }
			}
			halt if( !f_visited );
			halt if( c_visited );
			halt if( i_visited );
		}
		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_switch( v1 )
			{
				// Order of specified cases should be irrelevant. It's only important to enumerate all types.
				( f32 f ) -> { f_visited= true; },
				( i32 i ) ->{ i_visited= true; },
				( char8 c ) -> { halt if( c != 'G' ); c_visited= true; }
			}
			halt if( f_visited );
			halt if( !c_visited );
			halt if( i_visited );
		}
		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_switch( v2 )
			{
				// Order of specified cases should be irrelevant. It's only important to enumerate all types.
				( i32 i ) ->{ halt if( i != 784 ); i_visited= true; },
				( char8 c ) -> { c_visited= true; },
				( f32 f ) -> { f_visited= true; }
			}
			halt if( f_visited );
			halt if( c_visited );
			halt if( !i_visited );
		}
	}
	{ // "variant_switch" with values modification
		var ust::variant</ tup[ f32, char8, i32 ] /> mut v0= 5436.125f, mut v1= 'q', mut v2= -636;

		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_switch( mut v0 )
			{
				( f32 &mut f ) -> { halt if( f != 5436.125f ); f= 77.8f; f_visited= true; },
				( char8 &mut c ) -> { c_visited= true; },
				( i32 &mut i ) ->{ i_visited= true; }
			}
			halt if( !f_visited );
			halt if( c_visited );
			halt if( i_visited );
			halt if( v0.try_get</f32/>() != 77.8f );
		}
		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_switch( mut v1 )
			{
				( f32 &mut f ) -> { f_visited= true; },
				( char8 &mut c ) -> { halt if( c != 'q' ); c= 'J'; c_visited= true; },
				( i32 &mut i ) ->{ i_visited= true; }
			}
			halt if( f_visited );
			halt if( !c_visited );
			halt if( i_visited );
			halt if( v1.try_get</char8/>() != 'J' );
		}
		{
			var bool mut f_visited= false, mut c_visited= false, mut i_visited= false;
			variant_switch( mut v2 )
			{
				( f32 &mut f ) -> { f_visited= true; },
				( char8 &mut c ) -> { c_visited= true; },
				( i32 &mut i ) ->{ halt if( i != -636 ); i= 999978; i_visited= true; }
			}
			halt if( f_visited );
			halt if( c_visited );
			halt if( !i_visited );
			halt if( v2.try_get</i32/>() != 999978 );
		}
	}
	{ // Specifying mutable values (not references) in "variant_visit" should not change underlying value.
		var ust::variant</ tup[ f32, i32 ] /> mut v0= 123545, v1= 25.5f;
		{
			var bool mut f_visited= false, mut i_visited= false;
			variant_switch( mut v0 )
			{
				( f32 mut f ) -> { f= 0.0f; f_visited= true; },
				( i32 mut i ) -> { i= 0; i_visited= true; }
			}
			halt if( v0.try_get</i32/>() != 123545 );
			halt if( f_visited );
			halt if( !i_visited );
		}
		{
			var bool mut f_visited= false, mut i_visited= false;
			variant_switch( v1 )
			{
				( f32 mut f ) -> { f= 0.0f; f_visited= true; },
				( i32 mut i ) -> { i= 0; i_visited= true; }
			}
			halt if( v0.try_get</i32/>() != 123545 );
			halt if( !f_visited );
			halt if( i_visited );
		}
	}
	{ // "variant_visit" with stored variants processed as imutable references.
		var ust::variant</ tup[ NonCopyableStruct, f32 ] /> v0= NonCopyableStruct{ .x= 7474 }, v1= 78.5f;

		{
			var bool mut s_visited= false, mut f_visited= false;
			variant_switch( v0 )
			{
				( NonCopyableStruct& s ) -> { halt if( s.x != 7474 ); s_visited= true; },
				( f32& f ) -> { f_visited= true; }
			}
			halt if( !s_visited );
			halt if( f_visited );
		}
		{
			var bool mut s_visited= false, mut f_visited= false;
			variant_switch( v1 )
			{
				( NonCopyableStruct& s ) -> { s_visited= true; },
				( f32& f ) -> { halt if( f != 78.5f ); f_visited= true; }
			}
			halt if( s_visited );
			halt if( !f_visited );
		}
	}
	{
		halt if( GetVariantKindOneBasedIndexSquared( 7564i64 ) != 1u );
		halt if( GetVariantKindOneBasedIndexSquared( -2644.2637f ) != 4u );
		halt if( GetVariantKindOneBasedIndexSquared( "Nero" ) != 9u );
	}

	return 0;
}

struct NonCopyableStruct
{
	i32 x;
	fn constructor( mut this, NonCopyableStruct& other )= delete;
	op=( mut this, NonCopyableStruct& other )= delete;
}

fn GetVariantKindOneBasedIndexSquared( ust::variant</ tup[ i64, f32, [ char8, 4 ] ] />& v ) : u32
{
	variant_switch( v )
	{
		( i64 i ) -> { return 1u * 1u; },
		( f32 f ) -> { return 2u * 2u; },
		( [ char8, 4 ] c ) -> { return 3u * 3u; }
	}
	// No need to specify "return" here, since "variant_switch" above returns in all branches.
}
